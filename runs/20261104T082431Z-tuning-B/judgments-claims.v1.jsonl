{"case_id":"c005","arm":"A","repeat":0,"judge":"claims.v1","judge_sha":"bf30d0bf2186820d60f77249537f76877adfbec48aafa70a4defc410007dd3e7","status":"ok","output":{"claims":[{"text":"When creating a refund for a charge, you can specify whether the application fee should be refunded.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"If the full charge is refunded, the full application fee will be refunded.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"If the charge is partially refunded, the refund amount of the application fee will be proportional to the refunded charge amount.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"Only the application that created the charge can refund the application fee.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"}],"relevance":5},"detail":null,"cached":false,"usage":{"input_tokens":657,"output_tokens":224}}
{"case_id":"c005","arm":"B","repeat":0,"judge":"claims.v1","judge_sha":"bf30d0bf2186820d60f77249537f76877adfbec48aafa70a4defc410007dd3e7","status":"ok","output":{"claims":[{"text":"When you refund a charge, you can choose to refund the application fee as well.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"If you issue a full refund, the entire application fee will be refunded.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"For partial refunds, the application fee is refunded proportionally.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"},{"text":"Only the application that created the charge can refund the application fee.","kind":"api_fact","material":true,"attributed_to":"stripe","verdict":"supported","evidence_id":"stripe:refunds.create.refund_application_fee"}],"relevance":5},"detail":null,"cached":false,"usage":{"input_tokens":649,"output_tokens":211}}
